#!/usr/bin/env bash
set -euo pipefail

fields=$(parse token-request.schema.json who wants)
who='' wants=''
eval "$fields"

export who wants
exchange=$(format exchange-request.schema.json who wants)
response=$(printf '%s' "$exchange" | exchanger) || {
  failed=$?
  echo "token-service: the exchanger serving $wants failed" >&2
  exit "$failed"
}

printf '%s' "$response" | parse token-response.schema.json

printf '%s\n' "$response"
