#!/usr/bin/env bash
set -euo pipefail

plugins=${EXCHANGER_DIR:-@libdir@/gettoken/exchangers}

fields=$(parse exchange-request.schema.json wants)
wants=''
eval "$fields"

service=${wants%%/*}
plugin="$plugins/$service"

if [ ! -f "$plugin" ] || [ ! -x "$plugin" ]; then
  echo "exchanger: no plugin serves $wants" >&2
  exit 1
fi

key=host-privileged/$service
export key
asked=$(format secret-get-request.schema.json key)

fields=$(printf '%s' "$asked" | secret-get --with-key | parse secret-get-response.schema.json value)
value=''
eval "$fields"

access_token=$(printf '%s' "$value" | "$plugin" "$wants") || {
  failed=$?
  echo "exchanger: the plugin serving $wants failed" >&2
  exit "$failed"
}

expires_in=120
export access_token expires_in

format token-response.schema.json access_token expires_in
