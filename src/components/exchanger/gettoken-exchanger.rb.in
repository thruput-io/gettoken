class GettokenExchanger < Formula
  desc "Token broker for AI agents - gettoken-exchanger"
  homepage "https://github.com/thruput-io/gettoken"
  url "@URL@"
  sha256 "@SHA256@"
  license "Apache-2.0"

@DEPENDS@

  def install
    system "make", "configured", "prefix=#{HOMEBREW_PREFIX}"
    (lib/"gettoken").install "components/exchanger/exchanger"
  end
end
