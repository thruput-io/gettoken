#!/bin/bash
set -euo pipefail

store=${SECRET_DIR:-/var/lib/gettoken/secrets}

with_key=false
if [ "${1:-}" = "--with-key" ]; then
  with_key=true
  shift
fi

if [ "$with_key" = true ]; then
  fields=$(parse secret-get-request.schema.json key)
  key='' version=''
  eval "$fields"
else
  fields=$(parse secret-get-request-version.schema.json key version)
  key='' version=''
  eval "$fields"
fi

dir="$store/$key"

if [ -d "$dir" ]; then
  held=$(find "$dir" -maxdepth 1 -type f | sed 's|.*/||' \
    | awk '/^(0|[1-9][0-9]*)$/' | sort -n | tail -1)
else
  held=''
fi

if [ -z "$held" ]; then
  echo "secret-get: nothing is stored under $key" >&2
  exit 1
fi

version=${version:-$held}

if [ ! -f "$dir/$version" ]; then
  echo "secret-get: $key has no version $version" >&2
  exit 1
fi

value=$(cat "$dir/$version")
export version value

format secret-get-response.schema.json version value
