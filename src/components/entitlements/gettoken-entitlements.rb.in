class GettokenEntitlements < Formula
  desc "Token broker for AI agents - gettoken-entitlements"
  homepage "https://github.com/thruput-io/gettoken"
  url "@URL@"
  sha256 "@SHA256@"
  license "Apache-2.0"

@DEPENDS@

  def install
    (lib/"gettoken").install "components/entitlements/entitlements"
  end
end
