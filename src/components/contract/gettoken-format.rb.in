class GettokenFormat < Formula
  desc "Token broker for AI agents - gettoken-format"
  homepage "https://github.com/thruput-io/gettoken"
  url "@URL@"
  sha256 "@SHA256@"
  license "Apache-2.0"

  depends_on "go" => :build
@DEPENDS@

  def install
    system "make", "contract", "prefix=#{HOMEBREW_PREFIX}"
    (lib/"gettoken").install "build/bin/format"
  end
end
