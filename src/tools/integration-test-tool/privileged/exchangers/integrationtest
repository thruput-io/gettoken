#!/usr/bin/env bash
set -euo pipefail

wants=$1

case "$wants" in
  integrationtest/ci/run) ;;
  *) echo "integrationtest: nothing is registered for $wants" >&2; exit 1 ;;
esac

secret=$(cat)

case "$secret" in
  super-?*) ;;
  *) echo "integrationtest: the secret it was handed is not a super-token it can trade" >&2; exit 1 ;;
esac

printf '%s\n' "${secret#super-}-ci-run-allowed"
