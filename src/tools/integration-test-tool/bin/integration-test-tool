#!/bin/bash
set -euo pipefail

token=${INTEGRATIONTEST_TOKEN:-}

case "$token" in
  ?*-ci-run-allowed) ;;
  *) echo "integration-test-tool: INTEGRATIONTEST_TOKEN does not allow integrationtest/ci/run" >&2; exit 1 ;;
esac

echo "integration-test-tool: ran integrationtest/ci/run" >&2
printf '%s\n' "${token%-ci-run-allowed}"
