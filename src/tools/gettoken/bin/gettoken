#!/bin/bash
set -euo pipefail

PATH="/usr/lib/gettoken:/usr/bin:/bin:$PATH"
export PATH

refuse() {
  echo "gettoken: usage: gettoken [-f FILE] (--list | <capability>)" >&2
  exit 1
}

into=()
asked=()
while [ $# -gt 0 ]; do
  case $1 in
    -f) [ $# -ge 2 ] || refuse; into=(-f "$2"); shift 2 ;;
    *) asked+=("$1"); shift ;;
  esac
done

[ "${#asked[@]}" -eq 1 ] || refuse

if [ "${asked[0]}" = --list ]; then
  query=list
  export query
  ask=$(format agent-list-request.schema.json query)
  entitlements-requester ${into[@]+"${into[@]}"} "$ask"
else
  wants=${asked[0]}
  export wants
  ask=$(format agent-capability-request.schema.json wants)
  token-requester ${into[@]+"${into[@]}"} "$ask"
fi
