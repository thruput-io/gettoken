class GettokenTokenRequester < Formula
  desc "Token broker for AI agents - gettoken-token-requester"
  homepage "https://github.com/thruput-io/gettoken"
  url "@URL@"
  sha256 "@SHA256@"
  license "Apache-2.0"

@DEPENDS@

  def install
    (lib/"gettoken").install "tools/gettoken/privileged/token-requester"
  end
end
