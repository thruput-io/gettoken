{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.io/gettoken/defs.schema.json",
  "description": "The shapes every other contract is built from. An agent name, an activity, a capability, a signature, a key, a secret, a version, a lifetime. Nothing crosses a boundary except as one of these.",
  "$defs": {
    "Agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "Activity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "Capability": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[a-z0-9._-]+)+$"
    },
    "Signature": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4096,
      "not": {
        "pattern": "[\u0000-\u001f\u007f]"
      }
    },
    "AccessToken": {
      "type": "string",
      "minLength": 1
    },
    "ExpiresIn": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "CapabilityPattern": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/([a-z0-9._-]+|\\{[a-z][a-z0-9_]*\\}))+$"
    },
    "VariableName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "not": {
        "pattern": "[\u0000-\u001f\u007f]"
      }
    },
    "Key": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
    },
    "Secret": {
      "type": "string",
      "minLength": 1
    },
    "Version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
