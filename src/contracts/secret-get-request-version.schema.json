{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.io/gettoken/secret-request-key.schema.json",
  "title": "secret request with key",
  "description": "Asking the store for one version under a key, for a caller that needs the one it read before rather than whatever is newest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "version"
  ],
  "properties": {
    "key": {
      "$ref": "defs.schema.json#/$defs/Key"
    },
    "version": {
      "$ref": "defs.schema.json#/$defs/Version"
    }
  }
}
