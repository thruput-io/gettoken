{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.io/gettoken/response.schema.json",
  "title": "gettoken response",
  "type": "object",
  "additionalProperties": false,
  "required": ["access_token", "expires_in"],
  "properties": {
    "access_token": { "$ref": "defs.schema.json#/$defs/AccessToken" },
    "expires_in": { "$ref": "defs.schema.json#/$defs/ExpiresIn" }
  }
}
