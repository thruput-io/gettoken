{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.io/gettoken/secret-get-request.schema.json",
  "title": "secret-get request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key": { "$ref": "defs.schema.json#/$defs/Key" },
    "version": { "$ref": "defs.schema.json#/$defs/Version" }
  },
  "oneOf": [
    { "required": ["key", "version"] },
    { "required": ["key"], "not": { "required": ["version"] } }
  ]
}
