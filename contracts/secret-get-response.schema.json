{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.io/gettoken/secret-get-response.schema.json",
  "title": "secret-get response",
  "type": "object",
  "oneOf": [
    {
      "required": ["found", "version", "value"],
      "properties": {
        "found": { "const": true },
        "version": { "$ref": "defs.schema.json#/$defs/Version" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    {
      "required": ["found", "version"],
      "not": { "required": ["value"] },
      "properties": {
        "found": { "const": false },
        "version": { "$ref": "defs.schema.json#/$defs/Version" }
      }
    }
  ]
}
