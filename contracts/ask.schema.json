{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.io/gettoken/ask.schema.json",
  "title": "what an agent asks gettoken for",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "wants": { "$ref": "defs.schema.json#/$defs/Capability" },
    "query": { "const": "list" }
  },
  "oneOf": [
    { "required": ["wants"], "not": { "required": ["query"] } },
    { "required": ["query"], "not": { "required": ["wants"] } }
  ]
}
