#!/bin/sh
set -eu

PATH="/usr/lib/gettoken:/usr/bin:/bin:$PATH"
export PATH

if [ $# -ne 1 ]; then
  echo "gettoken: usage: gettoken --list | gettoken <capability>" >&2
  exit 1
fi

if [ "$1" = --list ]; then
  query=list
  export query
  ask=$(format ask.schema.json query)
else
  wants=$1
  export wants
  ask=$(format ask.schema.json wants)
fi

printf '%s' "$ask" | token-requester
