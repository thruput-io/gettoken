#!/bin/sh
set -eu

PATH="/usr/lib/gettoken:/usr/bin:/bin:$PATH"
export PATH

if [ $# -ne 1 ]; then
  echo "gettoken: usage: gettoken --list | gettoken <capability>" >&2
  exit 1
fi

if [ "$1" = --list ]; then
  ask=$(format entitlements-ask.schema.json)
  printf '%s' "$ask" | token-requester --list
else
  ask=$(format ask.schema.json "wants=$1")
  printf '%s' "$ask" | token-requester
fi
