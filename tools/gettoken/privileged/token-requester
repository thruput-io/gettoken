#!/bin/sh
set -eu

fields=$(parse ask.schema.json wants query)
wants='' query=''
eval "$fields"

who=$(id -un)
doing=$(hostname)
signed=host-privileged
export who doing signed

if [ "$query" = list ]; then
  request=$(format entitlements-request.schema.json who doing signed)

  entitled=$(printf '%s' "$request" | entitlements)
  printf '%s' "$entitled" | parse entitlements-response.schema.json
  printf '%s\n' "$entitled"
  exit 0
fi

export wants
request=$(format request.schema.json who doing wants signed)

response=$(printf '%s' "$request" | token-service)

fields=$(printf '%s' "$response" | parse response.schema.json access_token)
access_token=''
eval "$fields"

printf '%s\n' "$access_token"
