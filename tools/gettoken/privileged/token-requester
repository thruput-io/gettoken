#!/bin/sh
set -eu

if [ $# -eq 0 ]; then
  echo "gettoken: usage: gettoken --list | gettoken <capability>" >&2
  exit 1
fi

if [ "$1" = --list ]; then
  exec entitlements
fi

request=$(format request.schema.json \
  "who=$(id -un)" \
  "doing=$(hostname)" \
  "wants=$1" \
  signed=host-privileged)

printf '%s' "$request" | token-service
