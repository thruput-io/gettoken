#!/bin/sh
set -eu

if [ $# -eq 0 ]; then
  echo "gettoken: usage: gettoken --list | gettoken <capability>" >&2
  exit 1
fi

if [ "$1" = --list ]; then
  exec entitlements
fi

request=$(jq -nc \
  --arg who "$USER" \
  --arg doing "$(hostname)" \
  --arg wants "$1" \
  --arg signed host-privileged \
  '{who: $who, doing: $doing, wants: $wants, signed: $signed}')

response=$(printf '%s' "$request" | token-service)

access_token=$(printf '%s' "$response" | jq -r '.access_token // empty')

if [ -z "$access_token" ]; then
  echo "gettoken: no token in response" >&2
  exit 1
fi

printf '%s\n' "$access_token"
