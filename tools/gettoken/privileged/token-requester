#!/bin/sh
set -eu

if [ "${1:-}" = --list ]; then
  parse entitlements-ask.schema.json

  request=$(format entitlements-request.schema.json \
    "who=$(id -un)" \
    "doing=$(hostname)" \
    signed=host-privileged)

  entitled=$(printf '%s' "$request" | entitlements)
  printf '%s' "$entitled" | parse entitlements-response.schema.json
  printf '%s\n' "$entitled"
  exit 0
fi

fields=$(parse ask.schema.json wants)
wants=''
eval "$fields"

request=$(format request.schema.json \
  "who=$(id -un)" \
  "doing=$(hostname)" \
  "wants=$wants" \
  signed=host-privileged)

response=$(printf '%s' "$request" | token-service)

fields=$(printf '%s' "$response" | parse response.schema.json access_token)
access_token=''
eval "$fields"

printf '%s\n' "$access_token"
