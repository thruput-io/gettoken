#!/bin/sh
set -eu

fields=$(parse exchange-request.schema.json wants)
wants=''
eval "$fields"

case "$wants" in
  integrationtest/ci/run) ;;
  *) echo "integrationtest: nothing is registered for $wants" >&2; exit 1 ;;
esac

key=host-privileged/integrationtest
export key
asked=$(format secret-get-request.schema.json key)

fields=$(printf '%s' "$asked" | secret-get --with-key | parse secret-get-response.schema.json value)
value=''
eval "$fields"

if [ "$value" != integrationtest-supertoken ]; then
  echo "integrationtest: the stored super-token is not one this exchanger can trade" >&2
  exit 1
fi

access_token=integrationtest-ci-run-allowed
expires_in=120
export access_token expires_in

format token-response.schema.json access_token expires_in
