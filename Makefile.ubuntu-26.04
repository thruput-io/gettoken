PACKAGE_PLATFORMS = ubuntu-slim ubuntu-26.04

.PHONY: setup-ubuntu-26.04 package-ubuntu-26.04 \
        $(PACKAGE_PLATFORMS:%=package-for-%)

setup-ubuntu-26.04:
	sudo apt-get update
	sudo apt-get install -y --no-install-recommends jq bats shellcheck golang-go kcov gnupg

package-ubuntu-26.04: $(PACKAGE_PLATFORMS:%=package-for-%)

BASH_PARSER = /bin/bash
