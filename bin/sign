#!/bin/sh
# sign <agent> <location>
# STUB. Emits a JWS-compact-shaped client_assertion so the request honors the
# ClientAssertion contract. This is NOT a real signature — the local face of
# agent-identity-authority. First incarnation uses a throwaway dev key that
# token-service does not trust yet; later a GitHub App key makes it real proof.
b64() { base64 | tr '+/' '-_' | tr -d '='; }
h=$(printf '{"alg":"none","typ":"JWT"}' | b64)
p=$(printf '{"iss":"%s","loc":"%s"}' "$1" "$2" | b64)
printf '%s.%s.%s' "$h" "$p" "dev"
