# shellcheck shell=bash

export INSTALL_COMMAND="brew install --no-ask"
export BUILD_DEPS="jq bats-core shellcheck go kcov bash gnupg xmlstarlet dpkg"
export UNPRIVILEGED_USER="nobody"

export PUBLISH_DEB_COMMAND="scripts/publish-deb-to-container.sh package-archive"
export PUBLISH_BREW_COMMAND="scripts/publish-brew-to-container.sh package-archive"

ARCHIVE_SIGNING_KEY=$(cat "$HOME/.gettoken-archive-key.asc")
export ARCHIVE_SIGNING_KEY
