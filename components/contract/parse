#!/bin/sh
set -eu

contracts=${CONTRACTS_DIR:-/usr/share/gettoken/contracts}
schema=$1
shift

if [ ! -f "$contracts/$schema" ]; then
  echo "parse: no contract named $schema in $contracts" >&2
  exit 1
fi

document=$(cat)

if ! why=$(printf '%s' "$document" | json-schema-eval \
     --add-schema "$contracts/defs.schema.json" \
     --schema "$contracts/$schema" \
     --data /dev/stdin 2>&1); then
  echo "parse: the document does not satisfy $schema" >&2
  printf '%s\n' "$why" | sed 's/^/  /' >&2
  exit 1
fi

[ "$#" -gt 0 ] || exit 0

printf '%s' "$document" | jq -r --args '
  . as $document
  | $ARGS.positional[]
  | . as $field
  | ($document[$field] | if . == null then "" else tostring end | @sh) as $value
  | "\($field)=\($value)"
' "$@"
