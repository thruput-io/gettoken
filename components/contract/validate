#!/bin/sh
set -eu

contracts=${CONTRACTS_DIR:-/usr/share/gettoken/contracts}
schema=$1

if [ ! -f "$contracts/$schema" ]; then
  echo "validate: no contract named $schema in $contracts" >&2
  exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if ! json-schema-eval \
     --add-schema "$contracts/defs.schema.json" \
     --schema "$contracts/$schema" \
     --data /dev/stdin > "$work/why" 2>&1; then
  echo "validate: the document does not satisfy $schema" >&2
  sed 's/^/  /' "$work/why" >&2
  exit 1
fi
