#!/bin/sh
set -eu

store=${SECRET_DIR:-/var/lib/gettoken/secrets}

fields=$(parse secret-get-request.schema.json key version)
key='' version=''
eval "$fields"

dir="$store/$key"

if [ -d "$dir" ]; then
  held=$(find "$dir" -maxdepth 1 -type f | sed 's|.*/||' \
    | grep -E '^(0|[1-9][0-9]*)$' | sort -n | tail -1)
else
  held=''
fi

if [ -z "$held" ]; then
  echo "secret-get: nothing is stored under $key" >&2
  exit 1
fi

version=${version:-$held}

if [ ! -f "$dir/$version" ]; then
  echo "secret-get: $key has no version $version" >&2
  exit 1
fi

format secret-get-response.schema.json "version=$version" "value@$dir/$version"
