#!/bin/sh
set -eu

store=${SECRET_DIR:-/var/lib/gettoken/secrets}

fields=$(parse secret-get-request.schema.json key version)
key='' version=''
eval "$fields"

dir="$store/$key"

if [ -d "$dir" ]; then
  held=$(find "$dir" -maxdepth 1 -type f | sed 's|.*/||' \
    | grep -E '^(0|[1-9][0-9]*)$' | sort -n | tail -1)
else
  held=''
fi

if [ -z "$held" ]; then
  echo "secret-get: nothing is stored under $key" >&2
  exit 1
fi

if [ -n "$version" ] && [ ! -f "$dir/$version" ]; then
  format secret-get-response.schema.json found=false "version=$held"
  exit 0
fi

version=${version:-$held}
format secret-get-response.schema.json found=true "version=$version" "value@$dir/$version"
