#!/bin/sh
set -eu

store=${SECRET_DIR:-/var/lib/gettoken/secrets}

fields=$(printf '%s' "$1" | parse secret-get-request.schema.json holder service version)
holder='' service='' version=''
eval "$fields"

dir="$store/$holder/$service"
held=$(find "$dir" -maxdepth 1 -type f 2>/dev/null | sed 's|.*/||' | sort -n | tail -1)

if [ -z "$held" ]; then
  echo "secret-get: nothing is stored for $holder/$service" >&2
  exit 1
fi

if [ -n "$version" ] && [ ! -f "$dir/$version" ]; then
  format secret-get-response.schema.json found=false "version=$held"
  exit 0
fi

version=${version:-$held}
format secret-get-response.schema.json found=true "version=$version" "value=@$dir/$version"
