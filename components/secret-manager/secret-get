#!/bin/sh
set -eu

store=${SECRET_DIR:-/secret}

holder=$(printf '%s' "$1" | jq -r '.holder // empty')
service=$(printf '%s' "$1" | jq -r '.service // empty')
wanted=$(printf '%s' "$1" | jq -r '.version // empty')

if [ -z "$holder" ] || [ -z "$service" ]; then
  echo "secret-get: the request names no holder or no service" >&2
  exit 1
fi

dir="$store/$holder/$service"
held=$(ls "$dir" 2>/dev/null | sort -n | tail -1)

if [ -z "$held" ]; then
  echo "secret-get: nothing is stored for $holder/$service" >&2
  exit 1
fi

if [ -n "$wanted" ] && [ ! -f "$dir/$wanted" ]; then
  jq -nc --argjson version "$held" '{found:false,version:$version}'
  exit 0
fi

version=${wanted:-$held}
jq -nc --argjson version "$version" --rawfile value "$dir/$version" '{found:true,version:$version,value:$value}'
