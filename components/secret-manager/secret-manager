#!/bin/sh
set -eu

store=${SECRET_DIR:-/secret}

case "${1:-}" in
  put)
    name=$2
    mkdir -p "$store"
    cat > "$store/$name"
    ;;
  get)
    name=$2
    [ -f "$store/$name" ] || { echo "secret-manager: $name is not in $store" >&2; exit 1; }
    cat "$store/$name"
    ;;
  *)
    echo "usage: secret-manager put|get <name>   (the store is \$SECRET_DIR, or /secret)" >&2
    exit 1
    ;;
esac
