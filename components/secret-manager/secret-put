#!/bin/sh
set -eu

store=${SECRET_DIR:-/var/lib/gettoken/secrets}

printf '%s' "$1" | validate secret-put-request.schema.json

holder=$(printf '%s' "$1" | jq -r '.holder // empty')
service=$(printf '%s' "$1" | jq -r '.service // empty')
version=$(printf '%s' "$1" | jq -r '.version // empty')

if [ -z "$holder" ] || [ -z "$service" ] || [ -z "$version" ]; then
  echo "secret-put: the request names no holder, no service, or no version" >&2
  exit 1
fi

dir="$store/$holder/$service"

if [ -f "$dir/$version" ]; then
  echo "secret-put: version $version already exists for $holder/$service" >&2
  exit 1
fi

umask 077
mkdir -p "$dir"
cat > "$dir/$version"
