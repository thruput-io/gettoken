#!/bin/sh
set -eu

exchangers=${EXCHANGER_DIR:-/usr/lib/gettoken/exchangers}

fields=$(parse token-request.schema.json who wants)
who='' wants=''
eval "$fields"

exchanger="$exchangers/${wants%%/*}"

if [ ! -f "$exchanger" ] || [ ! -x "$exchanger" ]; then
  echo "token-service: no exchanger serves $wants" >&2
  exit 1
fi

export who wants
exchange=$(format exchange-request.schema.json who wants)
response=$(printf '%s' "$exchange" | "$exchanger")

printf '%s' "$response" | parse token-response.schema.json

printf '%s\n' "$response"
