#!/bin/sh
set -eu

exchangers=${EXCHANGER_DIR:-/usr/lib/gettoken/exchangers}

fields=$(parse request.schema.json who wants)
who='' wants=''
eval "$fields"

exchanger="$exchangers/${wants%%/*}"

if [ ! -f "$exchanger" ] || [ ! -x "$exchanger" ]; then
  echo "token-service: no exchanger serves $wants" >&2
  exit 1
fi

# The exchanger is told who is asking and what for, because that is what it
# trades on. Nothing else in the request is its business.
exchange=$(format exchange-request.schema.json "who=$who" "wants=$wants")
response=$(printf '%s' "$exchange" | "$exchanger")

# An exchanger is dropped into this directory rather than shipped by any package
# here, so its answer is the one document on this path that comes from outside.
printf '%s' "$response" | parse response.schema.json

printf '%s\n' "$response"
