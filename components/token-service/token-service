#!/bin/sh
set -eu

exchangers=${EXCHANGER_DIR:-/usr/lib/gettoken/exchangers}

request=$(cat)
wants=$(printf '%s' "$request" | jq -r '.wants // empty')

if [ -z "$wants" ]; then
  echo "token-service: the request names no capability" >&2
  exit 1
fi

exchanger="$exchangers/${wants%%/*}"

if [ ! -f "$exchanger" ] || [ ! -x "$exchanger" ]; then
  echo "token-service: no exchanger serves $wants" >&2
  exit 1
fi

exchange=$("$exchanger" "$wants")
access_token=$(printf '%s\n' "$exchange" | sed -n 1p)
expires_in=$(printf '%s\n' "$exchange" | sed -n 2p)

if [ -z "$access_token" ] || [ -z "$expires_in" ]; then
  echo "token-service: $exchanger returned no token" >&2
  exit 1
fi

printf '%s' "$access_token" | format response.schema.json access_token=@- "expires_in=$expires_in"
