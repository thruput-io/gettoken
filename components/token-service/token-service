#!/bin/sh
set -eu

exchangers=${EXCHANGER_DIR:-/usr/lib/gettoken/exchangers}

fields=$(parse request.schema.json wants)
wants=''
eval "$fields"

exchanger="$exchangers/${wants%%/*}"

if [ ! -f "$exchanger" ] || [ ! -x "$exchanger" ]; then
  echo "token-service: no exchanger serves $wants" >&2
  exit 1
fi

exchange=$("$exchanger" "$wants")
access_token=$(printf '%s\n' "$exchange" | sed -n 1p)
expires_in=$(printf '%s\n' "$exchange" | sed -n 2p)

if [ -z "$access_token" ] || [ -z "$expires_in" ]; then
  echo "token-service: $exchanger returned no token" >&2
  exit 1
fi

# An exchanger is dropped into a directory rather than shipped with this
# package, so its answer is the one thing on this path that arrives unchecked.
# Holding it to response.schema.json is what this is for. What leaves is the
# token itself: the caller is this machine's own privileged half, one process
# away, with nothing left to check that was not checked here.
printf '%s' "$access_token" \
  | format response.schema.json access_token@- "expires_in=$expires_in" > /dev/null

printf '%s\n' "$access_token"
