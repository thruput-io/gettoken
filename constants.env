BREW_TAP="thruput-io/tap"
DEBIAN_INSTALL_COMMAND="apt-get update && apt-get install -y --no-install-recommends"
DARWIN_INSTALL_COMMAND="brew install --no-ask"
DEBIAN_BUILD_DEPS="jq bats bats-support bats-assert shellcheck golang-go kcov xmlstarlet dpkg-dev apt-utils debhelper lintian build-essential golang-any git curl ca-certificates perl checkmake python3-check-jsonschema pipx"
DARWIN_BUILD_DEPS="jq bats-core bats-core/bats-core/bats-support bats-core/bats-core/bats-assert shellcheck go kcov bash xmlstarlet checkmake check-jsonschema"
DEBIAN_SEMGREP_INSTALL_COMMAND="bash scripts/semgrep-shim.sh build"
DARWIN_SEMGREP_INSTALL_COMMAND="brew install --no-ask semgrep"
DEBIAN_PACKAGE_FORMATS="deb"
DARWIN_PACKAGE_FORMATS="brew"
DEBIAN_BATS_LIB_PATH="/usr/lib/bats"
DARWIN_BATS_LIB_PATH="/opt/homebrew/lib"
DEBIAN_PATH_PREFIX="/usr/local/bin:"
DARWIN_PATH_PREFIX="/opt/homebrew/bin:"
DEBIAN_ADD_ARCHIVE='printf "Types: deb\nURIs: file:%s/build/dist/deb\nSuites: ./\nTrusted: yes\n" "$ROOT_DIR" > /etc/apt/sources.list.d/gettoken-dist.sources'
DARWIN_ADD_ARCHIVE='brew tap-new --no-git "$BREW_TAP" && brew trust "$BREW_TAP" && cp build/dist/brew/*.rb "$(brew --repository "$BREW_TAP")/Formula/"'
DEBIAN_INSTALL_PACKAGES="$DEBIAN_INSTALL_COMMAND integration-test-tool"
DARWIN_INSTALL_PACKAGES="$DARWIN_INSTALL_COMMAND "'$(brew formulae | grep "^$BREW_TAP/")'
DEBIAN_PRIVILEGED_PATH="/usr/lib/gettoken"
DARWIN_PRIVILEGED_PATH="/opt/homebrew/lib/gettoken"
DEBIAN_REMOVE_PACKAGES='apt-get purge -y gettoken-secret-manager && test ! -e /var/lib/gettoken'
DARWIN_REMOVE_PACKAGES='brew uninstall --formula $(brew formulae | grep "^$BREW_TAP/")'
