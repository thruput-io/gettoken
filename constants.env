LOCAL_SITE_URL="http://archive"
PROD_SITE_URL="https://thruput.se/gettoken"
DEBIAN_INSTALL_COMMAND="apt-get update && apt-get install -y --no-install-recommends"
DARWIN_INSTALL_COMMAND="brew install --no-ask"
DEBIAN_BUILD_DEPS="jq bats bats-assert shellcheck golang-go kcov gnupg xmlstarlet dpkg-dev debhelper lintian build-essential golang-any apt-utils git curl ca-certificates perl checkmake python3-check-jsonschema python3-pip"
DARWIN_BUILD_DEPS="jq bats-core/bats-core/bats-support bats-core/bats-core/bats-assert shellcheck go kcov bash gnupg xmlstarlet checkmake check-jsonschema"
DEBIAN_PACKAGE_FORMATS="deb"
DARWIN_PACKAGE_FORMATS="brew"