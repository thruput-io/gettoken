RELEASE_URL="https://github.com/thruput-io/gettoken/releases/download"
BREW_TAP="thruput-io/tap"
DEBIAN_INSTALL_COMMAND="apt-get update && apt-get install -y --no-install-recommends"
DARWIN_INSTALL_COMMAND="brew install --no-ask"
DEBIAN_BUILD_DEPS="jq bats bats-support bats-assert shellcheck golang-go kcov xmlstarlet dpkg-dev debhelper lintian build-essential golang-any git curl ca-certificates perl checkmake python3-check-jsonschema pipx"
DARWIN_BUILD_DEPS="jq bats-core bats-core/bats-core/bats-support bats-core/bats-core/bats-assert shellcheck go kcov bash xmlstarlet checkmake check-jsonschema"
DEBIAN_SEMGREP_INSTALL_COMMAND="bash scripts/semgrep-shim.sh build"
DARWIN_SEMGREP_INSTALL_COMMAND="brew install --no-ask semgrep"
DEBIAN_PACKAGE_FORMATS="deb brew"
DARWIN_PACKAGE_FORMATS="brew"
DEBIAN_BATS_LIB_PATH="/usr/lib/bats"
DARWIN_BATS_LIB_PATH="/opt/homebrew/lib"
DEBIAN_PATH_PREFIX="/usr/local/bin:"
DARWIN_PATH_PREFIX="/opt/homebrew/bin:"
DEBIAN_INSTALL_FORMAT="deb"
DARWIN_INSTALL_FORMAT="brew"
DEBIAN_LIB_DIR="/usr/lib/gettoken"
DARWIN_LIB_DIR="/opt/homebrew/lib/gettoken"
