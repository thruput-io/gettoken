LOCAL_SITE_URL="http://archive"
PROD_SITE_URL="https://thruput.se/gettoken"
DEBIAN_INSTALL_COMMAND="apt-get update && apt-get install -y --no-install-recommends"
DARWIN_INSTALL_COMMAND="brew install --no-ask"
DEBIAN_BUILD_DEPS="jq bats bats-support bats-assert shellcheck golang-go kcov gnupg xmlstarlet dpkg-dev debhelper lintian build-essential golang-any reprepro git curl ca-certificates perl checkmake python3-check-jsonschema pipx"
DARWIN_BUILD_DEPS="jq bats-core bats-core/bats-core/bats-support bats-core/bats-core/bats-assert shellcheck go kcov bash gnupg xmlstarlet checkmake check-jsonschema dpkg reprepro"
DEBIAN_SEMGREP_INSTALL_COMMAND="bash scripts/semgrep-shim.sh build"
DARWIN_SEMGREP_INSTALL_COMMAND="brew install --no-ask semgrep"
DEBIAN_PACKAGE_FORMATS="deb"
DARWIN_PACKAGE_FORMATS="brew"
DEBIAN_BATS_LIB_PATH="/usr/lib/bats"
DARWIN_BATS_LIB_PATH="/opt/homebrew/lib"
DEBIAN_PATH_PREFIX="/usr/local/bin:"
DARWIN_PATH_PREFIX="/opt/homebrew/bin:"
