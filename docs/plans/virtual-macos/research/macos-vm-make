#!/bin/bash
set -euo pipefail

root=$(CDPATH='' cd "$(dirname "$0")/../../../.." && pwd)
cd "$root"

targets=$*

(git ls-files --cached --others --exclude-standard | grep -v -E '^(gettoken/|profile$)'; find .git) \
  | COPYFILE_DISABLE=1 tar -cf - -T - \
  | macos-vm shell bash -lc "rm -rf \"\$HOME/gettoken\" && mkdir \"\$HOME/gettoken\" && cd \"\$HOME/gettoken\" && tar -xf - && make $targets"
