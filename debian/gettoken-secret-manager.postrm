#!/bin/bash
set -euo pipefail

if [ "$1" = purge ]; then
  rm -rf /var/lib/gettoken/secrets
  if [ -d /var/lib/gettoken ]; then
    rmdir /var/lib/gettoken \
      || echo "gettoken-secret-manager: /var/lib/gettoken holds something this package does not own, so it is left in place" >&2
  fi
fi

#DEBHELPER#
